# Proveedor de LLM: ollama | bedrock
LLM_PROVIDER=ollama

# --- Ollama (pruebas locales) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b

# --- AWS Bedrock (modelo más barato de Anthropic: Claude Haiku 5.5) ---
AWS_REGION=us-east-1
# Si tu cuenta usa inference profiles, puede requerir prefijo de región, p. ej. us.anthropic.claude-haiku-5-5
BEDROCK_MODEL_ID=anthropic.claude-haiku-5-5
# Credenciales: perfil AWS o variables estándar de AWS
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Orquestador ---
AGENT_MAX_RETRIES=3
AGENT_TIMEOUT_SECONDS=60
AGENT_RETRY_BACKOFF_SECONDS=0.5
IDENTITY_CONFIDENCE_THRESHOLD=0.8

# --- Mocks ---
# Probabilidad (0.0 - 1.0) de que una tool mock falle, para demostrar los reintentos
MOCK_FAILURE_RATE=0.0
